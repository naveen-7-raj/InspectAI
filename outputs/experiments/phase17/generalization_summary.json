  "key_findings": {
    "disjoint_generalization_confirmed": "Recording-disjoint evaluation confirms that CORAL does NOT rely on target label leakage or transductive test window visibility. Adapting on recordings 1-10 and evaluating on unseen recordings 11-20 yields an average balanced accuracy of 47.9% across conditions (vs. 8.6% baseline), with an inductive-transductive gap of less than 2.5 percentage points.",
    "recording_level_majority_voting": "Aggregating window predictions to recording level increases stability, reaching 55.0% balanced accuracy on N15_M07_F10 and 100% recall on Healthy Normal recordings across all conditions.",
    "speed_sensitivity_in_n09": "At 900 RPM (N09), baseline accuracy drops to 7.8% due to large frequency shift. Disjoint CORAL recovers balanced accuracy to 42.1%, showing cross-speed adaptation capability."
