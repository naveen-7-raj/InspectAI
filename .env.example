# ==============================================================================
# InspectAI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or container setup.
# Never commit real credentials or production secrets to version control.

# FastAPI Backend Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_URL=http://localhost:8000

# Streamlit Frontend Settings
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Compute Hardware Configuration (Optimized for CPU)
DEVICE=cpu

# Optional Custom Path Overrides (Defaults resolve relative to repository root)
# INSPECTAI_CONFIG_PATH=configs/config.yaml
# INSPECTAI_DATA_DIR=data
# INSPECTAI_MODEL_DIR=models/checkpoints

